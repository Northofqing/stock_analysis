#!/usr/bin/env ruby
# frozen_string_literal: true

require "base64"
require "cgi"
require "digest"

ROOT = File.expand_path("..", __dir__)
MARKDOWN_PATH = File.join(ROOT, "docs", "Project_Architecture_Blueprint.md")
HTML_PATH = File.join(ROOT, "docs", "Project_Architecture_Blueprint.html")

class BlueprintRenderer
  attr_reader :diagram_count, :section_count

  def initialize(markdown)
    @lines = markdown.lines(chomp: true)
    @ids = Hash.new(0)
    @diagram_count = 0
    @section_count = 0
  end

  def render
    output = []
    paragraph = []
    list_type = nil
    in_section = false
    preamble_open = false
    index = 0

    flush_paragraph = lambda do
      unless paragraph.empty?
        output << "<p>#{inline(paragraph.join(" "))}</p>"
        paragraph.clear
      end
    end

    close_list = lambda do
      if list_type
        output << "</#{list_type}>"
        list_type = nil
      end
    end

    while index < @lines.length
      line = @lines[index]

      if (fence = line.match(/^```([^`]*)$/))
        flush_paragraph.call
        close_list.call
        language = fence[1].strip
        code_lines = []
        index += 1
        while index < @lines.length && @lines[index] != "```"
          code_lines << @lines[index]
          index += 1
        end
        raise "unterminated fenced code block" if index >= @lines.length

        code = code_lines.join("\n")
        output << (language == "mermaid" ? render_mermaid(code) : render_code(code, language))
        index += 1
        next
      end

      if line.start_with?("| ") && index + 1 < @lines.length && table_delimiter?(@lines[index + 1])
        flush_paragraph.call
        close_list.call
        table_lines = [line, @lines[index + 1]]
        index += 2
        while index < @lines.length && @lines[index].start_with?("| ")
          table_lines << @lines[index]
          index += 1
        end
        output << render_table(table_lines)
        next
      end

      if (heading = line.match(/^(\#{1,4})\s+(.+)$/))
        flush_paragraph.call
        close_list.call
        level = heading[1].length
        title = heading[2].strip
        id = unique_slug(title)

        case level
        when 1
          output << '<div class="document-preamble">'
          preamble_open = true
          output << %(<h1 id="#{id}">#{inline(title)}</h1>)
        when 2
          output << "</div>" if preamble_open
          preamble_open = false
          output << "</div></section>" if in_section
          @section_count += 1
          output << %(<section class="blueprint-section" data-section-id="#{id}">)
          output << %(<div class="section-title-row"><h2 id="#{id}">#{inline(title)}</h2><button class="section-toggle" type="button" aria-expanded="true" aria-controls="body-#{id}"><span aria-hidden="true">−</span><span class="sr-only">折叠本节</span></button></div>)
          output << %(<div class="section-body" id="body-#{id}">)
          in_section = true
        else
          output << %(<h#{level} id="#{id}">#{inline(title)}</h#{level}>)
        end
        index += 1
        next
      end

      if line.start_with?("> ")
        flush_paragraph.call
        close_list.call
        quote_lines = []
        while index < @lines.length && @lines[index].start_with?("> ")
          quote_lines << @lines[index].delete_prefix("> ").sub(/\s{2}\z/, "")
          index += 1
        end
        output << "<blockquote>#{quote_lines.map { |entry| inline(entry) }.join("<br>")}</blockquote>"
        next
      end

      if (item = line.match(/^([-*])\s+(.+)$/)) || (item = line.match(/^(\d+)\.\s+(.+)$/))
        flush_paragraph.call
        wanted_type = item[1].match?(/\d/) ? "ol" : "ul"
        item_text = item[2]
        if list_type != wanted_type
          close_list.call
          list_type = wanted_type
          output << "<#{list_type}>"
        end
        output << "<li>#{inline(item_text)}</li>"
        index += 1
        next
      end

      if line == "---"
        flush_paragraph.call
        close_list.call
        output << "<hr>"
        index += 1
        next
      end

      if line.strip.empty?
        flush_paragraph.call
        close_list.call
      else
        paragraph << line.strip
      end
      index += 1
    end

    flush_paragraph.call
    close_list.call
    output << "</div>" if preamble_open
    output << "</div></section>" if in_section
    output.join("\n")
  end

  private

  def unique_slug(title)
    raw = title.gsub(/[`*_]/, "").downcase
    base = raw.gsub(/[^\p{L}\p{N}]+/u, "-").gsub(/\A-+|-+\z/, "")
    base = "section" if base.empty?
    @ids[base] += 1
    @ids[base] == 1 ? base : "#{base}-#{@ids[base]}"
  end

  def inline(source)
    code_fragments = []
    protected = source.gsub(/`([^`]+)`/) do
      token = "\u0000CODE#{code_fragments.length}\u0000"
      code_fragments << "<code>#{CGI.escapeHTML(Regexp.last_match(1))}</code>"
      token
    end
    rendered = CGI.escapeHTML(protected)
    rendered.gsub!(/\*\*(.+?)\*\*/, '<strong>\1</strong>')
    rendered.gsub!(/\*([^*]+?)\*/, '<em>\1</em>')
    code_fragments.each_with_index do |fragment, index|
      rendered.gsub!("\u0000CODE#{index}\u0000", fragment)
    end
    rendered
  end

  def table_delimiter?(line)
    cells = split_table_row(line)
    !cells.empty? && cells.all? { |cell| cell.match?(/\A:?-{3,}:?\z/) }
  end

  def split_table_row(line)
    content = line.strip
    content = content[1..] if content.start_with?("|")
    content = content[0...-1] if content.end_with?("|")
    cells = []
    buffer = +""
    in_code = false
    content.each_char do |character|
      if character == "`"
        in_code = !in_code
        buffer << character
      elsif character == "|" && !in_code
        cells << buffer.strip
        buffer = +""
      else
        buffer << character
      end
    end
    cells << buffer.strip
    cells
  end

  def render_table(lines)
    header = split_table_row(lines.first)
    rows = lines.drop(2).map { |line| split_table_row(line) }
    width = header.length
    raise "table row width mismatch" unless rows.all? { |row| row.length == width }

    head = header.map { |cell| "<th>#{inline(cell)}</th>" }.join
    body = rows.map do |row|
      "<tr>#{row.map { |cell| "<td>#{inline(cell)}</td>" }.join}</tr>"
    end.join("\n")
    %(<div class="table-wrap"><table><thead><tr>#{head}</tr></thead><tbody>\n#{body}\n</tbody></table></div>)
  end

  def render_code(code, language)
    class_name = language.empty? ? "" : %( class="language-#{CGI.escapeHTML(language)}")
    %(<pre class="code-block"><code#{class_name}>#{CGI.escapeHTML(code)}</code></pre>)
  end

  def render_mermaid(code)
    @diagram_count += 1
    number = format("%02d", @diagram_count)
    escaped = CGI.escapeHTML(code)
    encoded = Base64.strict_encode64(code)
    <<~HTML.strip
      <figure class="diagram-shell" data-diagram-index="#{@diagram_count}">
      <figcaption><span><span class="diagram-number">FIG #{number}</span> Mermaid architecture view</span>
      <span class="diagram-actions"><button type="button" data-diagram-action="zoom-out" aria-label="缩小">−</button><button type="button" data-diagram-action="reset" aria-label="重置缩放">1:1</button><button type="button" data-diagram-action="zoom-in" aria-label="放大">＋</button><button type="button" data-diagram-action="fullscreen" aria-label="全屏查看">全屏</button></span></figcaption>
      <div class="diagram-stage"><div class="diagram-canvas" aria-live="polite"></div><pre class="diagram-raw-preview"><code>#{escaped}</code></pre></div>
      <details class="diagram-fallback"><summary>查看 Mermaid 原文（渲染失败时仍可用）</summary><pre><code>#{escaped}</code></pre></details>
      <script type="text/plain" class="diagram-source">#{encoded}</script>
      </figure>
    HTML
  end
end

def replace_once!(html, pattern, replacement, label)
  matches = html.scan(pattern).length
  raise "expected one #{label}, found #{matches}" unless matches == 1

  html.sub!(pattern, replacement)
end

def metric(markdown, pattern, label)
  value = markdown[pattern, 1]
  raise "missing #{label} metric in Markdown" unless value

  value
end

markdown = File.binread(MARKDOWN_PATH).force_encoding(Encoding::UTF_8)
template = File.binread(HTML_PATH).force_encoding(Encoding::UTF_8)
renderer = BlueprintRenderer.new(markdown)
article = renderer.render
sha256 = Digest::SHA256.hexdigest(markdown.b)
generated_date = metric(markdown, /生成日期：(\d{4}-\d{2}-\d{2})/, "generation date")
modules = metric(markdown, /### A\.1 (\d+) 个/, "module")
binaries = metric(markdown, /### A\.3 (\d+) 个/, "binary")
tests = metric(markdown, /## 附录 B：(\d+) 个/, "integration test")
grpc_operations = metric(markdown, /### C\.1 (\d+) 个/, "gRPC operation")
decision_states = metric(markdown, /## 附录 G：DecisionState 完整目录（(\d+)）/, "decision state")
legacy_tables = metric(markdown, /## 附录 D：.*（(\d+)）/, "legacy table")
selection_tables = metric(markdown, /## 附录 E：.*（(\d+)）/, "selection table")
durable_tables = metric(markdown, /## 附录 F：.*（(\d+)）/, "durable table")
encoded_markdown = Base64.strict_encode64(markdown).scan(/.{1,120}/).join("\n")

replace_once!(template, /<body data-source-sha256="[0-9a-f]{64}">/, %(<body data-source-sha256="#{sha256}">), "body source hash")
replace_once!(template, /<p class="brand-meta">.*?<\/p>/m, %(<p class="brand-meta">Implementation-ready<br>Code-evidenced · #{generated_date}</p>), "brand metadata")
replace_once!(template, /<div class="sidebar-foot">SOURCE SHA-256<br>[0-9a-f]{64}<\/div>/, %(<div class="sidebar-foot">SOURCE SHA-256<br>#{sha256}</div>), "sidebar source hash")
replace_once!(template, /<p class="hero-copy">.*?<\/p>/m, %(<p class="hero-copy">此页面由 <code>Project_Architecture_Blueprint.md</code> 机械生成。它覆盖系统边界、运行时拓扑、数据所有权、#{grpc_operations} 个 consumer-used gRPC operations、推送专项，以及 v18/v19 设计与当前代码的覆盖裁决。</p>), "hero copy")

metrics_html = <<~HTML.chomp
        <div class="metrics" aria-label="架构清单统计">
          <div class="metric"><strong>#{modules}</strong><span>public modules</span></div>
          <div class="metric"><strong>#{binaries}</strong><span>binaries</span></div>
          <div class="metric"><strong>#{tests}</strong><span>integration tests</span></div>
          <div class="metric"><strong>#{grpc_operations}</strong><span>consumer gRPC ops</span></div>
          <div class="metric"><strong>#{renderer.diagram_count}</strong><span>Mermaid views</span></div>
          <div class="metric"><strong>#{decision_states}</strong><span>decision states</span></div>
          <div class="metric"><strong>#{legacy_tables}</strong><span>legacy catalog tables</span></div>
          <div class="metric"><strong>#{selection_tables}</strong><span>selection-v2 tables</span></div>
          <div class="metric"><strong>#{durable_tables}</strong><span>durable delivery tables</span></div>
        </div>
HTML
replace_once!(template, /<div class="metrics".*?<\/div>\n\s*<div class="status-legend"/m, "#{metrics_html}\n<div class=\"status-legend\"", "hero metrics")

legend_html = <<~HTML.chomp
        <div class="status-legend" id="status-legend" aria-label="架构状态图例">
          <span class="status-chip status-current">CURRENT</span>
          <span class="status-chip status-conditional">CONDITIONAL</span>
          <span class="status-chip status-compat">COMPAT</span>
          <span class="status-chip status-inactive">INACTIVE</span>
          <span class="status-chip status-external">EXTERNAL</span>
          <span class="status-chip status-proposed">PROPOSED</span>
          <span class="status-chip status-historical">HISTORICAL</span>
        </div>
HTML
replace_once!(template, /<div class="status-legend".*?<\/div>/m, legend_html, "status legend")
replace_once!(template, /<span id="content-summary">.*?<\/span>/, %(<span id="content-summary">完整蓝图 · #{renderer.section_count} 个章节 · #{renderer.diagram_count} 张架构图</span>), "content summary")
replace_once!(template, /      <article id="blueprint-content".*?      <\/article>/m, %(      <article id="blueprint-content" aria-label="完整项目架构蓝图">\n#{article}\n      </article>), "rendered article")
replace_once!(template, /      <p class="source-note">.*?<\/p>/m, %(      <p class="source-note">SOURCE · Project_Architecture_Blueprint.md<br>SHA-256 · #{sha256}<br>GENERATED VIEW · 内容完整嵌入，Mermaid CDN 失败时保留原始图文本。</p>), "source note")
replace_once!(template, /  <script id="blueprint-data" type="application\/octet-stream">.*?  <\/script>/m, %(  <script id="blueprint-data" type="application/octet-stream">\n#{encoded_markdown}\n  </script>), "embedded Markdown")

raise "section count mismatch" unless template.scan(/class="blueprint-section"/).length == renderer.section_count
raise "diagram count mismatch" unless template.scan(/class="diagram-shell"/).length == renderer.diagram_count
raise "embedded Markdown mismatch" unless Base64.decode64(encoded_markdown).b == markdown.b
raise "source hash mismatch" unless Digest::SHA256.hexdigest(Base64.decode64(encoded_markdown).b) == sha256

if ARGV == ["--check"]
  abort "#{HTML_PATH} is stale; run #{File.basename(__FILE__)}" unless template == File.read(HTML_PATH)
  puts "architecture blueprint HTML is current (#{renderer.section_count} sections, #{renderer.diagram_count} diagrams, sha256=#{sha256})"
elsif ARGV.empty?
  temporary_path = "#{HTML_PATH}.tmp"
  File.write(temporary_path, template)
  File.rename(temporary_path, HTML_PATH)
  puts "rendered #{HTML_PATH} (#{renderer.section_count} sections, #{renderer.diagram_count} diagrams, sha256=#{sha256})"
else
  abort "usage: #{File.basename(__FILE__)} [--check]"
end
