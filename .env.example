# =====================================================================
# A股自选股智能分析系统 - 环境变量配置
# 复制为 .env 并按需修改；以 # 开头为注释
# =====================================================================

# ============ 1. 自选股 ============
# 6 位股票代码，逗号分隔；必须由操作员显式填写真实关注范围。
# STOCK_LIST=000001,600000

# ============ 2. 数据库 ============
# 主业务 SQLite 路径（默认 ./data/stock_analysis.db）
# 推送分析独立使用 data/push_analytics.db，不受此变量替换。
# BR-192 计数型投递独立固定使用编译期仓库根下的
# data/durable_delivery.sqlite3；禁止通过 DATABASE_PATH、CWD 或环境变量覆盖。
# DATABASE_PATH=./data/stock_analysis.db

# 仅供显式读取 STOCK_DB 的离线回填、模拟器和合规脚本使用。
# monitor 与 stock_analysis 主运行时不读取该变量，不能用它替代 DATABASE_PATH。
# STOCK_DB=./data/stock_analysis.db

# ============ 3. 运行入口与模式开关（按二进制分别生效） ============
# 裸 `monitor` 长驻服务的生命周期开关；只有 true（不区分大小写）才启动。
# 显式终端命令（如 --review / --test）不受此开关拦截。
# MONITOR_ENABLED=false

# `--review` 顶层超时（秒）：默认 300；必须是正整数，0 或非法值回退默认值。
# MONITOR_REVIEW_TIMEOUT_SECS=300

# 以下 SCHEDULE/LHB/MARKET_REVIEW 变量只属于 `stock_analysis` 二进制，
# 不控制 `monitor`；CLI 参数和环境开关按该二进制的分派优先级解析。

# 定时任务：每日 SCHEDULE_TIME 触发
# SCHEDULE_ENABLED=false
# SCHEDULE_TIME=09:30

# 龙虎榜缓存查询模式：只读取已经过验证的本地缓存，不触发网络采集。
# LHB_MODE=false
# LHB_DATE=20260128             # 留空=今日
# LHB_MIN_SCORE=60              # 0-100，建议 60/70/80

# 大盘复盘模式
# MARKET_REVIEW_ENABLED=false

# ============ 4. AI 模型（至少配 1 个 API_KEY） ============
# --- Gemini（Google）---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
# GEMINI_MAX_RETRIES=3
# GEMINI_RETRY_DELAY=2.0          # 秒
# GEMINI_REQUEST_DELAY=0.0        # 秒，调用间隔

# --- 豆包（字节）---
# DOUBAO_API_KEY=your_doubao_api_key_here
# DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DOUBAO_MODEL=ep-20241230184254-j6pvd

# --- DeepSeek（国产，OpenAI 兼容协议）---
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# BR-172 证券级 NewsAI 仅运行不可推送的影子审计；默认关闭。
# 开启后每轮最多分析 5 个来源明确绑定的证券，单模型调用超时 45 秒。
# STOCK_ANALYSIS_NEWS_AI_SHADOW_ENABLE=false
# LLM_ROLE_NEWS_AI=deepseek
# LLM_DEFAULT_FALLBACK=deepseek
# 也可选择 MiniMax（OpenAI 兼容协议）：
# MiniMax_API_KEY=your_minimax_api_key_here
# MiniMax_BASE_URL=https://api.minimaxi.com/v1
# MiniMax_MODEL=MiniMax-Text-01

# 深度思考开关（Gemini thinkingConfig / 豆包 thinking）
# AI_DEEP_THINKING=false

# 宏观 AI 新闻分析开关（默认开启=true）
# 关闭=不调用宏观新闻 AI 推荐选股，节省 LLM 调用与启动耗时
# MACRO_AI_ENABLED=true

# 宏观多 Agent 流水线开关（默认开启=true）
# 开启=4 位宏观专家并行（产业链推演/政策解读/板块轮动/情绪风险）→ 首席策略师融合终稿
# 关闭=回退单 prompt 直接生成
# MACRO_AGENT_PIPELINE=true

# 持仓自动追踪开关（默认开启=true）
# 关闭=不自动把数据库 open 仓位加入候选池，且跳过模拟买卖与四大铁律
# POSITION_TRACKING_ENABLED=true

# ============ 5. 多 Agent 流水线（受 TradingAgents 启发） ============
# 默认开启：6 位分析师（基本面/技术面/资金面/消息面/行业板块/时间窗口）
#   → 多空 N 轮辩论 → 风控审查 → 仲裁终稿
# 完整一只股票约 9~11 次 LLM 调用；关闭后回退单 prompt
# AI_AGENT_PIPELINE=true

# 多空辩论轮数（1=只陈述, 2=互相反驳[默认], 3=深度对抗）
# AI_DEBATE_ROUNDS=2

# Agent 追踪日志：true 时打印每个 Agent 的输入切片/JSON 视角/多空全文/终稿
# 默认仅打印评分概要 + 终稿前 600 字预览
# AI_AGENT_TRACE=false

# Quick / Deep 双模型路由（不设则统一用主模型）
# Quick = 6 个分析师 + 风控（低延迟）
# Deep  = 多空辩论 + 仲裁（启用 AI_DEEP_THINKING 时打开思考）
# AI_QUICK_MODEL=gemini-2.5-flash-lite
# AI_DEEP_MODEL=gemini-2.5-flash
# DOUBAO_QUICK_MODEL=
# DOUBAO_DEEP_MODEL=
# DEEPSEEK_QUICK_MODEL=deepseek-chat
# DEEPSEEK_DEEP_MODEL=deepseek-reasoner

# ============ 6. 统一数据边界 ============
# 公共金融/新闻事实统一由固定 revision 的 magic-market-data-rs Gateway 获取。
# 不提供本地旧 provider 选择开关；账户、持仓、现金和订单能力不属于公共数据 Gateway。

# 实时执行行情统一使用 Magic Gateway（TDX 为首个路由候选）。
# 默认 magic_tdx；public / magic 是同一路径的兼容别名，其他值显式报错。
# BROKER_SOURCE=magic_tdx

# ============ 7. 搜索服务（新闻/消息面） ============
# GlobalNewsGateway 轮询间隔（秒），默认 120；非法值回退默认值。
# NEWS_POLL_INTERVAL=120

# 多 Key 轮转：用英文逗号分隔可配多把，自动按可用性切换
# SerpAPI（Google 搜索）
# SERPAPI_KEYS=key1,key2

# Tavily（备用搜索）
# TAVILY_API_KEYS=key1,key2

# 博查（Bocha）
# BOCHA_API_KEYS=key1,key2

# ============ 8. 通知推送（按需启用） ============
# 任一渠道只需配齐对应字段即自动启用，无需开关
# 渠道未启用时留空即可

# --- 邮件（5 项必须同时配齐：缺一即报错）---
# EMAIL_SENDER=your_email@163.com           # 发件人邮箱（=SMTP 用户名）
# EMAIL_PASSWORD=your_smtp_authcode         # SMTP 授权码（非登录密码！）
# EMAIL_RECEIVERS=a@x.com,b@y.com           # 收件人，逗号分隔；第一个=主，其余=抄送
# SMTP_SERVER=smtp.163.com                  # 例：163=smtp.163.com / QQ=smtp.qq.com / Gmail=smtp.gmail.com
# SMTP_PORT=465                             # 465=SSL；587=STARTTLS

# --- 企业微信群机器人 ---
# WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# WECHAT_MAX_BYTES=4000                     # 单条消息上限，默认 4000

# --- 飞书群机器人 ---
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# FEISHU_MAX_BYTES=20000                    # 单条消息上限，默认 20000

# --- BR-196 完整模板验收（只能使用独立的非生产飞书会话）---
# 以下字段只定义测试目标身份；实际发送凭据仍由独立测试 MagicLaw 配置管理。
# 目标身份哈希还必须经评审加入
# config/br196_non_production_feishu_targets.toml 的 non_production_acceptance。
# 禁止填写普通生产推送所使用的会话；production_deny 会显式拒绝。
# BR196_LIVE_FEISHU_ACCEPTANCE=1
# BR196_FEISHU_TENANT_ID=your_non_production_tenant_id
# BR196_FEISHU_APP_ID=your_non_production_app_id
# BR196_FEISHU_CONVERSATION_ID=your_non_production_conversation_id
# MAGICLAW_BIN=/absolute/path/to/non-production/magiclaw
# MAGICLAW_HOME=/absolute/path/to/non-production/magiclaw-home
# MAGICLAW_HOME/.env 的 FEISHU_ACCOUNT_ID / FEISHU_APP_ID 必须与上述目标一致。

# --- Telegram ---
# TELEGRAM_BOT_TOKEN=xxxxx:yyyyy
# TELEGRAM_CHAT_ID=123456789

# --- Pushover ---
# PUSHOVER_USER_KEY=
# PUSHOVER_API_TOKEN=

# --- 自定义 Webhook（可多个）---
# CUSTOM_WEBHOOK_URLS=https://hook1,https://hook2
# CUSTOM_WEBHOOK_BEARER_TOKEN=optional_bearer_token

# ============ 9. CLI 操作员认证 (BR-028, 默认禁用) ============
# monitor 启动前会通过系统 PAM 验证 operator 密码. 失败 → exit 1.
# 未设置时默认当前 Unix 用户. CI/CD / 定时任务可以走默认跳过, 不强制认证.
# 单机 single-user 默认不打扰, 不认证直接跑. 生产 cron / 共享主机 设 1 启用认证.
# MONITOR_OPERATOR=your_unix_username
# MONITOR_PAM_SERVICE=login
# MONITOR_AUTH_REQUIRED=1   # 1 = 启用 PAM 认证; 0 或 unset = 跳过 (默认)

# ============ 10. 其他 ============
# 并发分析线程数（默认 6，IO 密集；如触发 LLM 限流可调小）
# MAX_WORKERS=6

# 重点股深度研判（多智能体）并发度（默认 3，LLM 密集；与 MAX_WORKERS 独立，遇限流调小至 1 即退化为串行）
# DEEP_ANALYSIS_CONCURRENCY=3

# 日志级别（debug/info/warn/error），默认 info
# RUST_LOG=info
